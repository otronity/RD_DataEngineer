from "warehouse"."main"."stg_events" e
join "warehouse"."main"."event_categories" c
    on e.event_type = c.event_type
join "warehouse"."main"."calendar" cal
    on e.event_date = cal.day
group by
    e.event_date,
    cal.is_weekend,
    c.category
order by
    e.event_date,
    c.category
  );

